{
  auto_https off
}

:{$PORT} {

  log {
    output stdout
    format json
  }

  #################################################################
  # CORS
  #################################################################
  # Only short-circuits OPTIONS preflight here (cheap, avoids a round
  # trip to the backend for every preflight). Every backend service
  # already runs its own CORSMiddleware with the same effective
  # allow-list (CORS_ALLOWED_ORIGINS) and correctly handles CORS on the
  # actual GET/POST/etc. response — this file must NOT also add
  # Access-Control-Allow-Origin/-Credentials to proxied responses, or a
  # real request ends up with the header twice (once from here, once
  # from the backend). Two Access-Control-Allow-Origin values is invalid
  # per the Fetch spec and browsers reject the response outright, even
  # though curl happily prints both and makes it look fine.

  @cors_allowed_origin header_regexp origin Origin ^https://(safeborn\.app|mumcare-admin\.vercel\.app|mumcare-mobile\.vercel\.app)$|^http://localhost:(3000|8081)$

  @cors_preflight method OPTIONS
  handle @cors_preflight {
    header @cors_allowed_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
    header @cors_allowed_origin Access-Control-Allow-Credentials "true"
    header @cors_allowed_origin Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header @cors_allowed_origin Access-Control-Allow-Headers "Authorization, Content-Type, Accept"
    header @cors_allowed_origin Access-Control-Max-Age "3600"
    respond "" 204
  }

  header {
    -Server
  }


  #################################################################
  # ROUTES
  #################################################################

  handle /health {
    respond "gateway ok" 200
  }

  handle /auth* {
    reverse_proxy auth.railway.internal:8001 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /profile* {
    reverse_proxy profile.railway.internal:8002 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }


  handle /symptoms* {
    reverse_proxy symptom.railway.internal:8003 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /chat* {
    reverse_proxy chat.railway.internal:8004 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /tracker* {
    reverse_proxy tracker.railway.internal:8005 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /notifications* {
    reverse_proxy notification.railway.internal:8006 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /agent* {
    reverse_proxy agent.railway.internal:8007 {
      # Allow Websokets to upgrade gracefully through this path
      header_up Connection {header.Connection}
      header_up Upgrade {header.Upgrade}

      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /billing* {
    reverse_proxy billing.railway.internal:8008 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /data* {
    reverse_proxy data.railway.internal:8009 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /content* {
    reverse_proxy content.railway.internal:8010 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /pregnancy* {
    reverse_proxy pregnancy.railway.internal:8011 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /communities* {
    reverse_proxy community.railway.internal:8012 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /feedback* {
    reverse_proxy feedback.railway.internal:8013 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  # ── Pregnancy Journey Engine (Phases 1 & 4) ─────────────────────────────────
  # state-engine and labour services are not yet deployed on Railway — these
  # routes will 404 until the corresponding services exist and are configured
  # to listen on the ports below (or whatever port they're actually deployed
  # with; update to match).
  handle /state-engine* {
    reverse_proxy state-engine.railway.internal:8014 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }

  handle /labour* {
    reverse_proxy labour.railway.internal:8015 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }


  # ── VOICE ROUTE — now gated through chat_service, not the transcribe
  # service directly. Voice is a paid (Standard+) feature and every call
  # here is a billed request to the external transcribe service, so the
  # plan check has to happen BEFORE that service is ever reached — it
  # does no plan checking of its own. chat_service's /voice/* routes
  # (require_plan("standard")) do the gating, then proxy through to
  # transcribe.railway.internal themselves. handle (not handle_path) is
  # deliberate — chat_service's router expects the full /voice/... path,
  # not a stripped one.
  handle /voice* {
    reverse_proxy chat.railway.internal:8004 {
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}

      # Forces Caddy to push audio packets to the phone immediately as they arrive
      flush_interval -1

      transport http {
        response_header_timeout 60s
        read_timeout 90s
      }
    }
  }

  # ── WebSocket route for community real-time streaming ──────────────────────
  # Must be defined separately from /communities* because WebSocket upgrade
  # requests require explicit header forwarding to complete the handshake.
  # Without this rule, /ws/* hits the 404 fallback and the upgrade is rejected.
  handle /ws/* {
    reverse_proxy community.railway.internal:8012 {
      header_up Connection {header.Connection}
      header_up Upgrade {header.Upgrade}
      header_up Authorization {header.Authorization}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-For {remote}
      header_up Host {host}
    }
  }



  handle {
    respond "Not Found" 404
  }
}
